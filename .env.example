# Which upstream tracker this process runs: amtrak | buswhere | hudsonlink.
# Run one source per process (deploy one container each).
SOURCE=amtrak

# Shared
# Defaults to 15, or 60 for hudsonlink
# POLL_INTERVAL=15
HTTP_TIMEOUT=20
RT_API_INGEST_URL=http://localhost:8000
INGEST_API_TOKEN=dev-ingest-token
# Must equal an rt-api Tracker.id (the surrogate) in the target feed.
# INGEST_VEHICLE_ID is the old name for this and still works.
INGEST_TRACKER_ID=amtrakdriver
# GTFS defaults follow SOURCE (Amtrak national feed / Columbia County feed /
# Hudson Link 511NY feed);
# override only to pin a specific feed.
# GTFS_URL=
GTFS_PATH=/app/beat/gtfs_cache.zip

# amtrak-only: comma-separated RouteName allowlist (blank = all)
ROUTE_FILTER=

# buswhere-only: comma-separated route slugs to poll (blank = all mapped routes)
BUSWHERE_ROUTES=

# hudsonlink-only: CoachUSA service uuid scoping journey searches
# (defaults to Hudson Link's)
# HUDSONLINK_SERVICE_UUID=

# Gatus external endpoint for upstream-health heartbeats (skipped if unset).
# Each cycle reports success, or failure when the upstream could not be read.
# GATUS_URL=http://gatus:8080
# GATUS_ENDPOINT_KEY=pollers_amtrak-poller
# GATUS_TOKEN=
